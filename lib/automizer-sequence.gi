InstallMethod(ValidAutomizers, "method for finding valid automizers", 
    [IsPGroup, IsPGroup], function(S, E)
    local   AutE, # Aut(E)
            InnE, # Inn(E)
            AutSE, # Aut_S(E)
            p, # the prime
            n, # the nice monomorphism for Aut(E)
            L, # possible choices for Aut_F(E)
            i, # current position in L
            AutFE, # possible Aut_F(E)
            A, # O_p(Aut_F(E))
            q, # quotient map Aut_F(E) -> Aut_F(E)/A
            OutFE, # quotient Aut_F(E)/A
            OutSE, # quotient Aut_S(E)/A
            OutE, # quotient Aut(E)/A
            M, # the maximal subgroups of OutFE
            C, # the conjugates of subgroups in M containing OutSE
            I, # positions of conjugates in C containing OutSE
            a, # counter of new automizers
            X; # a subgroup in C or L

    p := PrimePGroup(S);

    AutE := AutomorphismGroup(E);
    n := NiceMonomorphism(AutE);
    InnE := Automizer(E, E);
    AutSE := Automizer(S, E);
    AutE := NiceObject(AutE);

    if IsBound(AutE!.autrec) then 
        InnE := FS_PcSubAutPGroup(AutE, InnE);
        AutSE := FS_PcSubAutPGroup(AutE, AutSE);
    else 
        InnE := Image(n, InnE);
        AutSE := Image(n, AutSE);
    fi;

    # Find subgroups containing AutSE within overgroups above p-core. Iterated maximal approach
    L := [CoprimeResidual(AutE,[p])];
    i := 0;

    while i < Length(L) do 
        i := i+1;
        AutFE := L[i];
        A := PCore(AutFE,p);

        q := NaturalHomomorphismByNormalSubgroup(AutFE, A);
        
        OutFE := Image(q);
        OutSE := Image(q, AutSE);
        Info(InfoFusion, 4, "\tFound section of order ", Size(OutFE));
        
        M := MaximalSubgroupClassReps(OutFE);
        Info(InfoFusion, 4, "\t\twhich has ", Length(M), " maximal subgroups");
        M := List(M, A -> CoprimeResidual(A,[p]));
        C := List(M, A -> ContainedConjugates(OutFE, A, OutSE, true));
        I := PositionsProperty(C, A -> A <> fail);
        Info(InfoFusion, 4, "\t\tof which ", Length(I), " contain Aut_S(E)");

        C := List(I, i -> M[i]^(C[i][2]^-1));
        C := List(C, A -> PreImage(q, A));

        a := 0;
        # Add missing G-conjugates
        for X in C do 
            if Intersection(PCore(X,p), AutSE) = InnE and ForAll(L, T -> not IsConjugate(AutE, T, X)) then 
                a := a+1;
                Add(L, X);
            fi;
        od;
        Info(InfoFusion, 4, "\t\tTotal ", a, " new automizer(s) up to Aut(E)-conjugacy");
    od;

    q := NaturalHomomorphismByNormalSubgroup(AutE, InnE);
    OutE := Image(q);
    L := Filtered(L, A -> IndexNC(A, ClosureGroup(AutSE, PCore(A,p))) mod p <> 0);
    L := List(L, A -> Image(q, A));
    OutSE := Image(q, AutSE);

    Info(InfoFusion, 4, "\t", Length(L), " possible valid radical automizer(s) (mod p-core)");

    # TODO: Filter the elements in L that have a strongly p-embedded subgroup (mod p-core)
    Info(InfoFusion, 4, "\t", Length(L), " possible valid essential automizer(s) (mod p-core)");

    L := List(L, A -> ComplementClassesRepresentatives(A, PCore(A,p)));
    L := Flat(L);

    C := List(L, A -> RepresentativeAction(OutE, SylowSubgroup(A,p), OutSE));
    I := PositionsProperty(C, A -> A <> fail);
    L := List(I, i -> L[i]^C[i]);
    L := List(L, A -> PreImage(q, A));
    Info(InfoFusion, 4, Length(L), " valid essential automizer(s)");

    L := List(L, A -> PreImage(n, A));

    for X in L do 
        SetIsGroupOfAutomorphismsFiniteGroup(X, true);
        SetAutomorphismDomain(X, E);
    od;

    return L;
end );

# Finds the subgroup of $\Aut(S)$ generated by extensions of $N_{\Aut_\calF(E)}(\Aut_S(E))$ (for $E$ maximal essential)
InstallMethod(FindSmallestBorel, "find smallest Borel", 
    [IsPGroup, IsGroupOfAutomorphismsFiniteGroup], function(S, AutFE)
    local E, AutSE, nE, nS, N, AutS, g, e;

    E := AutomorphismDomain(AutFE);
    AutSE := Automizer(S, E);

    nE := NiceMonomorphism(AutFE);
    AutFE := nE(AutFE);
    AutSE := nE(AutSE);
    
    AutS := AutomorphismGroup(S);
    nS := NiceMonomorphism(AutS);
    AutS := nS(AutS);

    N := Normalizer(AutFE, AutSE);
    
    if N = AutSE then 
        return TrivialSubgroup(AutS);
    fi;

    N := PreImage(nE, N);

    g := GeneratorsOfGroup(E);

    e := List(GeneratorsOfGroup(N), a -> RepresentativeAction(AutS, g, List(g, x -> a(x)), OnImageTuplesNM(nS)));

    if ForAny(e, x -> x = fail) then 
        return fail;
    fi;

    return Group(e);
end );

BindGlobal("FS_IsFullyNormalizedInSequence", function(S, AutFE0, E)
    local n, O;

    n := NiceMonomorphism(AutFE0);
    AutFE0 := n(AutFE0);

    # check that amongst subs $F \in E^\Aut_F(E_0)$, we have that $|N_S(F)| >= |N_S(E)|$
    O := Orbit(AutFE0, E, OnImageNM(n));

    return ForAll(O, E0 -> IndexNC(Normalizer(S,E), E) >= IndexNC(Normalizer(S, E0), E0));
end);

InstallMethod(IsAutomizerBorelCompatible, "check automizer is Borel-compatible", 
    [IsPGroup, IsGroupOfAutomorphismsFiniteGroup, IsGroupOfAutomorphismsFiniteGroup], function(S, AutFS, AutFE)
    local p, E, AutF0E, AutE, n, A0;

    p := PrimePGroup(S);
    E := AutomorphismDomain(AutFE);
    AutF0E := Automizer(AutFS, E);

    AutE := AutomorphismGroup(E);
    n := NiceMonomorphism(AutE);

    A0 := ClosureGroup(AutFE, AutF0E);
    A0 := n(A0);
    AutFE := n(AutFE);
    
    return CoprimeResidual(A0, [p]) = AutFE;
end);

# Checks whether the smallest choice for the focal subgroup in the fusion system
# is actually $S$. Currently, the subgroup $B$ is not guaranteed to actually 
# equal $\Aut_F^0(S)$.
InstallMethod(IsFocalCompatibleSequence, "check focal subgroup is the entire group", 
    [IsPGroup, IsGroupOfAutomorphismsFiniteGroup, IsList], function(S, B, P)
    local A, i, A0;

    A := CommutatorSubgroup(B, S);

    for i in [1..Length(P)] do 
        A0 := CommutatorSubgroup(P[i], AutomorphismDomain(P[i]));
        A := ClosureGroup(A, A0);
    od;

    return A = S;
end);

InstallMethod(IsCompatibleSequence, "check sequence compatible", 
    [IsPGroup, IsList], function(S, P)
    local p, L, tau, AutS, InnS, n, B, I, i, J, Ext, J0;

    p := PrimePGroup(S);
    L := List(P, AutomorphismDomain);
    tau := Sortex(List(L, Size));
    
    L := Permuted(L, tau);
    P := Permuted(P, tau);

    L := Reversed(L);
    P := Reversed(P);
    
    AutS := AutomorphismGroup(S);
    n := NiceMonomorphism(AutS);
    InnS := InnerAutomorphismGroup(S);
    
    InnS := n(InnS);
    AutS := n(AutS);

    B := InnS;
    Info(InfoFusion, 1, "Inn(S) has order ", Size(B));

    # TODO: Should try to compute $E^\calF$ here for accuracy
    for i in [1..Length(L)] do 
        # TODO: Up to F-conjugacy here
        J := List([1..i-1], j -> ContainedConjugates(S, L[j], L[i], true));
        if ForAll(J, i -> i = fail) then 
            Info(InfoFusion, 1, "E is maximal essential");
            Ext := FindSmallestBorel(S, P[i]);
            # should be maximal essential here
            if Ext = fail then 
                Info(InfoFusion, 1, "Maps don't extend to S");
                return false;
            fi;
            Info(InfoFusion, 1, "Maps extend to S");
            B := ClosureGroup(B, Ext);
            Info(InfoFusion, 1, "The Borel now has order ", Size(B));
            if IndexNC(B, InnS) mod p = 0 then 
                Info(InfoFusion, 1, "S no longer fully automized");
                return false;
            fi;
        else 
            Info(InfoFusion, 1, "E is not maximal essential");
            J0 := PositionsProperty(J, i -> i <> fail);
            # TODO: Conjugate the proto-essential automizer choices by the conjugating element
            if ForAny(J0, j -> not FS_IsFullyNormalizedInSequence(S, P[j]^J[j][2], L[i])) then 
                Info(InfoFusion, 1, "E not fully normalized with respect to some larger essential");
                return false;
            fi;
            Info(InfoFusion, 1, "E fully normalized with respect to some larger essential");
        fi;
    od;

    Info(InfoFusion, 1, "The Borel has order ", Size(B));
    # After finding the choice containing $\Aut_F^0(S)$, check that this restricts nicely to each automizer in the sequence,
    # i.e. $O^{p'}(\Aut_\calF(E^{(0)}))$ is part of the sequence ($E^{(0)}$ contains the restrictions from the group)
    B := PreImage(n, B);
    # TODO: We actually need the stronger condition to hold here! (make it a fn) -- if this gets bigger e.g. $\Alt(4)$ to $\Alt(5)$,
    # the $\Alt(4)$ version is invalid here -- we need the $\Alt(5)$ version to pass instead
    if ForAny(P, AutFE -> not IsAutomizerBorelCompatible(S, B, AutFE)) then 
        Info(InfoFusion, 1, "The automizer sequence doesn't have a valid Borel subgroup");
        return false;
    fi;

    Info(InfoFusion, 1, "Compatible focal = ", IsFocalCompatibleSequence(S, B, P));
    # This compatible sequence will likely further check for saturation on $\calF^{cr}$, the ultimate test for saturation

    return true;
end );

BindGlobal("FS_GetSequence", function(A, P)
    local U, i;

    U := [];
    for i in [1..Length(A)] do 
        if A[i] > 0 then 
            Add(U, P[i][A[i]]);
        fi;
    od;

    return U;
end);

BindGlobal("FS_FilterCorefreeSequences", function(S, L, P, D)
    local N, NP;
    
    N := NormalSubgroups(S);
    NP := List([1..Length(P)], i -> List(P[i], AutFE -> PositionsProperty(N, A -> IsSubset(L[i], A) and 
        ForAll(GeneratorsOfGroup(AutFE), phi -> Image(phi, A) = A))));

    return Filtered(D, A -> Length(Intersection(FS_GetSequence(A, NP))) = 1);
end);

InstallMethod(FindReducedSequences, "find reduced sequences",
    [IsPGroup, IsList], function(S, L)
    local IsSubSequence, P, I, D, ValidSequences, InvalidSequences, A, U;

    # checks whether one combination is a sub-combination of the other
    IsSubSequence := function(A, B)
        return ForAll([1..Length(A)], i -> A[i] = 0 or A[i] = B[i]);
    end;

    Info(InfoFusion, 1, "Finding valid automizers");
    P := List(L, E -> ValidAutomizers(S, E));
    I := PositionsProperty(L, A -> not IsEmpty(A));
    
    P := P{I};
    L := L{I};
    
    Info(InfoFusion, 1, "Checking whether combinations are valid");

    D := Cartesian(List(P, A -> [0..Length(A)])); # 0 represents the subgroup is not essential
    D := FS_FilterCorefreeSequences(S, L, P, D);
    Info(InfoFusion, 1, Length(D), " Corefree possibilities");

    ValidSequences := [];
    InvalidSequences := [];
    for A in D do 
        Info(InfoFusion, 1, "Checking combination ", A);

        if ForAny(InvalidSequences, B -> IsSubSequence(B, A)) then 
            Info(InfoFusion, 1, "Contains an incompatible sequence");
            continue;
        fi;

        U := FS_GetSequence(A, P);

        if IsCompatibleSequence(S, U) then 
            Info(InfoFusion, 1, "Valid");
            Add(ValidSequences, A);
        else 
            Add(InvalidSequences, A);
        fi;
    od;

    return ValidSequences;
end );

# For PE_ValidAutomizers, we should expect the number of $\Out(E)$-conjugates of $\Out_F(E)$ to equal the number of $\Out(S)|_E$-conjugates of $\Out_F(E)$.

InstallMethod(IsomorphismSequences, "find isomorphism between automizer sequences",
    [IsPGroup, IsList, IsList], function(S, P1, P2)
    local AutS, n;
    
    if Length(P1) <> Length(P2) then 
        return fail;
    fi;

    AutS := AutomorphismGroup(S);
    n := NiceMonomorphism(AutS);

    # TODO: Currently the fn. only works when every domain in $P_1$ is $\Aut(S)$-invariant
    return RepresentativeAction(AutS, P1, P2, OnPreImageTuples(n));
end);

# P is a list of generator automizer groups
# S is the p-group
# A is a subgroup of S
# If $\calF := \langle L \rangle$, then we return $(\Aut_\calF(A), A^\calF)$
# $A^\calF$ also contains the actual maps from $A$ to some $\calF$-conjugate
# Using Breadth-First Search
InstallMethod(OrbitStabilizerFusion, "generic method", 
    [IsPGroup, IsPGroup, IsList], function(S, A, P)
    local   Q,      # the queue
            m,      # maps for $\calF$-conjugates
            T,      # $A^\calF$
            Aut,    # $\Aut_\calF(A)$
            AutFE,  # $\Aut_\calF(E)$
            phi,    # $\phi \in \Aut_\calF(E)$
            X,      # $X \in A^\calF$
            X0,     # $S$-conjugate of $X$
            alpha,  # $\alpha \colon A \to X$
            beta,   # $\beta \colon A \to Y$
            c,      # $c \colon X \to X0$
            d,      # $d \colon Y0 \to Y$
            Y0,      # $X\phi$
            i;      # position of $X$ or $Y$ in $T$

    T := [A];
    Q := [A];
    m := [IdentityMapping(A)];

    Aut := Automizer(S, A);

    while not IsEmpty(Q) do 
        X := Remove(Q);
        i := Position(T, X);

        # alpha : A -> X
        # c : X -> X0
        # phi : X0 -> Y0
        # d : Y0 -> Y
        # beta : A -> Y 

        alpha := m[i];
        for AutFE in P do 
            for phi in GeneratorsOfGroup(AutFE) do 
                c := ContainedConjugates(S, Source(phi), X, true);
                if c <> fail then
                    c := ConjugatorIsomorphism(X, c[2]);
                    X0 := c(X);
                    Y0 := phi(X0);
                    phi := RestrictedHomomorphismOnto(phi, X0);
                    i := PositionProperty(T, Z -> IsConjugate(S, Y0, Z));
                    if i <> fail then 
                        d := RepresentativeAction(S, Y0, T[i]);
                        d := ConjugatorIsomorphism(Y0, d);
                        beta := m[i];
                        Aut := ClosureGroup(Aut, 
                            alpha*c*phi*d*InverseGeneralMapping(beta)
                        );
                    else
                        Add(T, Y0);
                        Add(Q, Y0);
                        Add(m, alpha*c*phi);
                    fi;
                fi;
            od;
        od;
    od;

    SetIsGroupOfAutomorphismsFiniteGroup(Aut, true);
    SetAutomorphismDomain(Aut, A);

    return rec(
        AutFA := Aut,
        orbit := T,
        maps := m
    );
end);

IsSuzukiTwoGroup:=function(P)

#Arguments:
#P is a 2-group.

#Purpose and output:
#Returns true if P is a Suzuki 2-group.

	local centP;
	centP:=Centre(P);
	return centP=Omega(P,2) and centP=DerivedSubgroup(P) and centP=FrattiniSubgroup(P);

end;

OpPrime := function(G, p)

#Arguments:
#G is a group.
#p is a prime.

#Purpose and output:
#Returns O_{p'}(G).

   	local F, result, q;
    	result := TrivialSubgroup(G);
    	for q in PrimeDivisors(Order(G)) do
        	if q <> p then
            	result := ClosureSubgroup(result, PCore(G, q));		#O_{p'}(G) is the subgroup generated by all the q-cores for each q<>p.
        	fi;
    	od;
    	return result;

end;

ContainsStronglyPEmbeddedSubgroup:=function(A, p)

#Arguments:
#A is a group.
#p is a prime.

#Purpose and output:
#Returns a Boolean variable corresponding to whether A contains a strongly p-embedded subgroup.

#Results used:
#Classification of groups with an SpE sbgp.
#Groups with SpE sbgp have trivial p-core.

#Notes:
#Currently we use the classification of groups with SpE sbgps, which splits into an easy p-rank 1 case and...
#...a case where we have a list of possible almost simple groups M:=O^{p'}(A/O_{p'}(A)).

#Alternatively, we could take a Sylow p-sbgp S and take the closure of all normalisers N_A(Q) for Q\leq S.
#A has an SpE sbgp iff this closure is not equal to A.
#Is there any way it suffices to take the normalisers of only a small number of sbgps Q\leq S?

#We could use a hybrid method depending on the complexity of S.

#Questions: which method is fastest?

	local S, ordSExp, pPrimeQuot, M, simpleData, simpleFamily, n, q, name;

	if IsPrimePowerInt(Order(A)) or Order(A) mod p <> 0 then
		return false;		#Instantly reject if A has order a prime power, or not divisible by p.
	fi;

	S:=SylowSubgroup(A,p);

	if IsCyclic(S) or IsQuaternionGroup(S) then
		#return not IsNormal(A,Omega(S,p));	#This is the condition in the p-rank 1 case, but...
		return IsTrivial(PCore(A,p));	#...this is an equivalent condition which I think is faster.
		
	elif IsSolvableGroup(A) then	#A cannot be soluble in the p-rank >1 case.
		return false;

	#We are now in the p-rank >1 case.
	#The structure of S is quite limited, so we perform some cheap checks on S to reject some more cases.
	elif not IsElementaryAbelian(S) then
		if p=2 and not IsSuzukiTwoGroup(S) then
			return false;
		elif p=3 and not (Order(S)=27 and not IsAbelian(S)) then
			ordSExp:=Log(Order(S),3);
			if not (Exponent(S)=3 and ordSExp mod 3 = 0) or
				( ordSExp>=9 and ordSExp mod 6 = 3 and (not IsAbelian(S)) and IsTrivial(CommutatorSubgroup(S, DerivedSubgroup(S))) ) then
				return false;		#Assuming that Exponent(PSU_3(3^n)=3) for all n. True for n<=3.
			fi;
		elif not ( Log(Order(S),p) mod 3 = 0 and (not IsAbelian(S)) and IsTrivial(CommutatorSubgroup(S, DerivedSubgroup(S))) ) then
			return false;
		fi;
	fi;
	
	#A necessary condition for A to have an SpE sbgp is O_p(A)=1.
	if not IsTrivial(PCore(A,p)) then
		return false;

	else
		pPrimeQuot:=A/OpPrime(A, p);
		M:=NormalClosure(pPrimeQuot, SylowSubgroup(pPrimeQuot, p) );		#M:=O^{p'}(A/O_{p'}(A)).
		
		#If A has Spe sbgp, then M lies on a list of almost simple groups.
		if not IsSimpleGroup(M) then		#Only 2 possibilities that are almost simple but not simple.
			if p=3 and Order(M)=1512 then	#Necessary checks for M=PSL_2(8):C_3.
				return ForAny( MaximalSubgroupClassReps(M), H -> IdGroup(H)=IdGroup(PSL(2,8)) );
			elif p=5 and Order(M)=162688000 then	#The only non-soluble group with this order is Sz(32):C_5.
				return true;
			else
				return false;
			fi;

		else	#M is simple.
			simpleData:=IsomorphismTypeInfoFiniteSimpleGroup(M);
			simpleFamily:=simpleData.series;
			name:=simpleData.name;

			if simpleFamily="Spor" then		#Sporadics.
				return (name="M(11)" and p=3) or (name in ["Fi(22)", "McL"] and p=5) or (name="J4" and p=11);

			elif IsList(simpleData.parameter) then		#M has 2 parameters n,q (classical gps of Lie type).
				n:=simpleData.parameter[1];
				q:=simpleData.parameter[2];
				if SmallestRootInt(q)=p then
					return (n=2 and simpleFamily="L" and q<>p) or (n=3-1 and q<>2 and simpleFamily="2A");	#Note change of indexing for unitary groups.
				else
					return (n=3 and q=4 and p=3 and simpleFamily="L");
				fi;

			else	#M has a single parameter q (alternating groups and exceptional groups of Lie type).
				q:=simpleData.parameter;
				if simpleFamily="A" and (q=2*p or (q=5 and p=2) or (q=6 and p=3)) then
					#Covers A_{2p} and exceptional isoms to A_5=PSL_2(4) and A_6=PSL_2(9)
					return true;
				elif simpleFamily="2B" and p=2 then
					return true;
				elif simpleFamily="2G" and p=3 then
					return true;
				elif simpleFamily="2F" and p=3 and q=2 then
					return true;
				else
					return false;
				fi;
			fi;
		fi;
	fi;

    return false;
end;

InstallMethod(WeakRadicalCheck, "weak radical check", 
    [IsPGroup, IsPGroup, IsList], function(S, W, P)
    local p, R, i, AutFW, AutW, n, AutSW, InnW, q, OutSW, OutFW, C, NSW, I, t;

    # Not centric => nothing to do
    if Centralizer(S,W) <> Center(W) then 
        Info(InfoFusion, 1, "Not centric in F");
        return true;
    fi;

    p := PrimePGroup(S);
    R := OrbitStabilizerFusion(S, W, P);
    Info(InfoFusion, 1, "Orbit-Stabilizer for W computed");

    # a fully normalized conjugate of P
    i := PositionMaximum(List(R.orbit, A -> Size(Normalizer(S,A))));
    AutFW := R.AutFA^(R.maps[i]);
    W := Image(R.maps[i], W);

    AutW := AutomorphismGroup(W);
    n := NiceMonomorphism(AutW);
    AutSW := Automizer(S, W);
    Info(InfoFusion, 1, "n(Aut_S(W)) to be found");
    AutSW := n(AutSW);
    Info(InfoFusion, 1, "n(Aut_F(W)) to be found");
    AutFW := n(AutFW);
    Info(InfoFusion, 1, "Found");

    # Need to check only if $O_p(\Aut_F(W)) \cap \Aut_S(W) = 1$ for some conjugate
    if ForAny([1..Length(R.orbit)], j -> Centralizer(S, R.orbit[i]) <> Center(R.orbit[i])) then 
        Info(InfoFusion, 1, "Not centric in F");
        return true;
# We're struggling with this for some reason
    elif ForAny([1..Length(R.orbit)], j -> Size(Intersection(
        n(Automizer(S,R.orbit[j])^(InverseGeneralMapping(R.maps[j])*R.maps[i])), 
        PCore(AutFW, p)))  <> Index(R.orbit[j], Center(R.orbit[j]))) then 
        Info(InfoFusion, 1, "Not radical in F");
        return true;
    fi;
    Info(InfoFusion, 1, "Radical in F");

    if Index(AutFW, AutSW) mod p = 0 then 
        Info(InfoFusion, 1, "Not fully automized");
        return false;
    fi;

    Info(InfoFusion, 1, "Aut_F(W) has order ", Size(AutFW));
    Info(InfoFusion, 1, "Aut_F(W) is ", StructureDescription(AutFW));
    

    if IsAbelian(W) then
        InnW := Group(IdentityMapping(W));
    else 
        InnW := InnerAutomorphismGroup(W);
    fi;
    InnW := n(InnW);

    q := NaturalHomomorphismByNormalSubgroup(AutFW, InnW);
    OutFW := Image(q, AutFW);
    OutSW := Image(q, AutSW);
    
    # weakly receptive => check every map in Aut_F(W) lifts to the expected radical subgroup
    C := SubgroupsSolvableGroup(OutSW);
    I := PositionsProperty(C, A -> Size(A) > 1 and Size(A) < Size(OutSW) and 
                            ContainsStronglyPEmbeddedSubgroup(Normalizer(OutFW, A)/A, p));
    C := C{I};
    C := List(C, A -> PreImage(q, A));

    NSW := Normalizer(S, W);

    # mapping S -> n(Aut_S(W))
    t := GroupHomomorphismByImagesNC(NSW, AutSW, GeneratorsOfGroup(NSW), 
        List(GeneratorsOfGroup(NSW), a -> n(ConjugatorAutomorphismNC(W, a))));
    # We have the isomorphism f \colon N_S(W)/W \to Out_S(W) 
    # Take preimage to find the subgroup in S
    
    C := List(C, A -> PreImage(t, A));
    Info(InfoFusion, 1, List(C, A -> [
        StructureDescription(A), 
        Size(n(Automizer(OrbitStabilizerFusion(S, A, P).AutFA, W))), 
        Size(Normalizer(AutFW, n(Automizer(A, W))))
    ]));

    # Check that
    # $\Aut_F(A) \downarrow W = N_{\Aut_F(W)}(\Aut_A(W))$
    # TODO: If that doesn't hold, check that A^F <> A^{Aut_F(S)}
    return ForAll(C, A -> 
        Size(n(Automizer(OrbitStabilizerFusion(S, A, P).AutFA, W))) = Size(Normalizer(AutFW, n(Automizer(A, W))))
    );
end);

BindGlobal("FS_Zip", function(L)
    local C;
    
    C := Cartesian(List(L, A -> [1..Length(A)]));
    return List(C, I -> List([1..Length(I)], i -> L[i][I[i]]));
end);
